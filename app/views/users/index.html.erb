<%# app/views/users/index.html.erb %>
<div class="flex items-center justify-between mb-5">
  <h1 class="text-xl font-bold">Users</h1>

  <% if policy(User).create? %>
    <%= link_to "Tambah User", new_user_path,
          class: "px-4 py-2 rounded-lg text-sm font-medium bg-emerald-600 text-white hover:bg-emerald-700" %>
  <% end %>
</div>

<div class="overflow-x-auto rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900">
  <table class="w-full text-sm text-left">
    <thead class="bg-slate-50 dark:bg-slate-800 text-slate-500">
      <tr>
        <th class="px-4 py-3">Nama</th>
        <th class="px-4 py-3">Email</th>
        <th class="px-4 py-3">Role</th>
        <th class="px-4 py-3 text-right">Aksi</th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr class="border-t border-slate-200 dark:border-slate-800">
          <td class="px-4 py-3 font-medium"><%= user.name %></td>
          <td class="px-4 py-3"><%= user.email %></td>
          <td class="px-4 py-3">
            <% user.roles.each do |role| %>
              <span class="inline-block mr-1 px-2 py-0.5 rounded-full text-xs bg-slate-100 dark:bg-slate-800">
                <%= role.name %>
              </span>
            <% end %>
          </td>
          <td class="px-4 py-3 text-right space-x-3">
            <% if policy(user).update? %>
              <%= link_to "Edit", edit_user_path(user), class: "text-emerald-600 hover:underline" %>
            <% end %>

            <% if policy(user).destroy? %>
              <%= button_to "Hapus", user_path(user), method: :delete,
                    form: { class: "inline", data: { turbo_confirm: "Hapus user #{user.name}?" } },
                    class: "text-red-600 hover:underline" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>