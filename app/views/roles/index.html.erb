<%# app/views/roles/index.html.erb %>
<div class="flex items-center justify-between mb-5">
  <h1 class="text-xl font-bold">Roles & Permission</h1>

  <% if policy(Role).create? %>
    <%= link_to "Tambah Role", new_role_path,
          class: "px-4 py-2 rounded-lg text-sm font-medium bg-emerald-600 text-white hover:bg-emerald-700" %>
  <% end %>
</div>

<div class="overflow-x-auto rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900">
  <table class="w-full text-sm text-left">
    <thead class="bg-slate-50 dark:bg-slate-800 text-slate-500">
      <tr>
        <th class="px-4 py-3">Nama</th>
        <th class="px-4 py-3">Deskripsi</th>
        <th class="px-4 py-3">Permission</th>
        <th class="px-4 py-3">User</th>
        <th class="px-4 py-3 text-right">Aksi</th>
      </tr>
    </thead>
    <tbody>
      <% @roles.each do |role| %>
        <tr class="border-t border-slate-200 dark:border-slate-800">
          <td class="px-4 py-3 font-medium"><%= role.name %></td>
          <td class="px-4 py-3"><%= role.description %></td>
          <td class="px-4 py-3"><%= role.permissions.size %></td>
          <td class="px-4 py-3"><%= @user_counts[role.id] || 0 %></td>
          <td class="px-4 py-3 text-right space-x-3">
            <% if policy(role).update? %>
              <%= link_to "Edit", edit_role_path(role), class: "text-emerald-600 hover:underline" %>
            <% end %>

            <% if RolePermissionPolicy.new(current_user, role).edit? %>
              <%= link_to "Permission", edit_role_permissions_path(role), class: "text-sky-600 hover:underline" %>
            <% end %>

            <% if policy(role).destroy? %>
              <%= button_to "Hapus", role_path(role), method: :delete,
                    form: { class: "inline", data: { turbo_confirm: "Hapus role #{role.name}?" } },
                    class: "text-red-600 hover:underline" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>