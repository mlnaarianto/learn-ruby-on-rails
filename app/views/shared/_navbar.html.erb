<%# app/views/shared/_navbar.html.erb %>
<header class="sticky top-0 z-20 h-14 px-4 flex items-center justify-between
               bg-white/80 dark:bg-slate-900/80 backdrop-blur
               border-b border-slate-200 dark:border-slate-800">

  <%# Kiri: tombol hamburger (hanya di mobile) %>
  <button type="button"
          data-action="click->sidebar#toggle"
          class="lg:hidden p-2 rounded-lg text-slate-600 hover:bg-slate-100
                 dark:text-slate-300 dark:hover:bg-slate-800"
          aria-label="Buka menu">
    <i class="fa-solid fa-bars"></i>
  </button>

  <%# Spacer supaya sisi kanan tetap di kanan saat di desktop %>
  <div class="hidden lg:block"></div>

  <%# Kanan: info user + logout %>
  <div class="flex items-center gap-3">
    <div class="text-right leading-tight">
      <p class="text-sm font-medium text-slate-800 dark:text-slate-200">
        <%= current_user.name %>
      </p>
      <p class="text-xs text-slate-500">
        <%= current_user.roles.map(&:name).join(", ") %>
      </p>
    </div>

    <%= button_to logout_path, method: :delete,
          class: "px-3 py-1.5 rounded-lg text-sm font-medium text-red-600
                  hover:bg-red-50 dark:hover:bg-red-500/10 cursor-pointer" do %>
      <i class="fa-solid fa-right-from-bracket mr-1"></i> Logout
    <% end %>
  </div>
</header>