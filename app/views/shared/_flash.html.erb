<%# app/views/shared/_flash.html.erb %>
<% if notice.present? || alert.present? %>
  <div class="container mx-auto mt-4 px-5">
    <% if notice.present? %>
      <div class="rounded-lg bg-emerald-100 text-emerald-800 px-4 py-3 mb-2" role="status">
        <%= notice %>
      </div>
    <% end %>
    <% if alert.present? %>
      <div class="rounded-lg bg-rose-100 text-rose-800 px-4 py-3 mb-2" role="alert">
        <%= alert %>
      </div>
    <% end %>
  </div>
<% end %>